{
  "name": "rfl-app",
  "version": "1.3.4",
  "description": "RFL-APP · F1 League Season 4",
  "main": "desktop/main.cjs",
  "author": "RFL",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/niiklasmea/rfl-mobile-app.git"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "de.RFL-LIGA",
    "productName": "RFL-APP",
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "site",
        "filter": [
          "index.html",
          "backend-config.js",
          "friends.js",
          "manifest.webmanifest",
          "service-worker.js",
          "INSTALLATION.txt",
          "assets/**/*",
          "icons/**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "niiklasmea",
        "repo": "rfl-mobile-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RFL-APP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RFL-APP",
      "deleteAppDataOnUninstall": false
    }
  },
  "packageManager": "pnpm@11.25.0"
}